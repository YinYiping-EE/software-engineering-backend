HOST=127.0.0.1
PORT=3001
# 可选：相对路径以 backend 目录为基准。
# DATABASE_PATH=.local/calculator.sqlite
# 默认不信任客户端传来的 X-Forwarded-For。
# 仅在 API 由本机可信反向代理访问、代理覆盖来源头时启用：
# TRUST_PROXY=loopback
# Production requires a persistent random secret (at least 32 characters) outside Git.
# NODE_ENV=production
# SESSION_SECRET=replace-with-a-generated-secret
# PUBLIC_ORIGIN=https://47.117.170.115
